# Caddy reverse proxy with FREE automatic HTTPS via sslip.io.
#
# sslip.io maps a hostname to your IP with no registration. Using a unique
# prefix (here "alaska") gives a dedicated hostname so Let's Encrypt issues a
# cert reliably. Caddy fetches + renews it automatically.
#
# Your links become:
#   https://alaska.136.110.36.47.sslip.io/stream/...
# Set in .env:  BASE_URL=https://alaska.136.110.36.47.sslip.io
# Open ports 80 AND 443 in the GCP firewall (80 is needed for the cert challenge).

alaska.136.110.36.47.sslip.io {
	reverse_proxy bot:8080 {
		# Stream bytes immediately (no buffering) — important for large downloads.
		flush_interval -1
	}
}

# --- Plain HTTP on the bare IP (optional fallback, no HTTPS) -----------------
# Uncomment to also serve http://136.110.36.47/ directly.
#
# http://136.110.36.47 {
# 	reverse_proxy bot:8080 {
# 		flush_interval -1
# 	}
# }

# --- Using a real/DuckDNS domain instead? -----------------------------------
# Replace the hostname above with your domain (A record -> 136.110.36.47) and
# set BASE_URL=https://yourdomain. Caddy handles the cert automatically.
