# Caddy reverse proxy with FREE automatic HTTPS.
#
# IMPORTANT: Telegram's "Download Now" (URL) buttons are REJECTED for hostnames
# that embed an IP (like sslip.io). Use a DuckDNS domain (no embedded IP) so the
# button works.
#
# Setup DuckDNS (free):
#   1. Go to https://www.duckdns.org, sign in, create a subdomain e.g. "alaskadl"
#   2. Set its IP to your VM's external IP (136.110.36.47)
#   3. Keep the domain below as alaskadl.duckdns.org (or change to your chosen name)
#   4. In .env set:  BASE_URL=https://alaskadl.duckdns.org
#   5. Open ports 80 AND 443 in the GCP firewall (80 is needed for the cert)

alaskafiletolink.duckdns.org {
	reverse_proxy bot:8080 {
		# Stream bytes immediately (no buffering) — important for large downloads.
		flush_interval -1
	}
}

# --- Alternative: sslip.io (free HTTPS, but URL BUTTONS won't work) ----------
# Fine if you don't need the Download Now button (links still open as text).
#
# alaska.136.110.36.47.sslip.io {
# 	reverse_proxy bot:8080 {
# 		flush_interval -1
# 	}
# }
