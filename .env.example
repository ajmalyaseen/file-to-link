# Copy this file to .env and fill in your values.

# --- Telegram (MTProto) ---
# Get API_ID and API_HASH from https://my.telegram.org -> "API development tools".
API_ID=1234567
API_HASH=your-api-hash-here

# Bot token from @BotFather.
BOT_TOKEN=123456:your-bot-token-here

SESSION_NAME=file2link_bot

# Private storage channel: create a channel, add the bot as admin, and put its
# id here (looks like -1001234567890). Incoming files are copied here so links
# stay valid even if the user deletes their message. Leave empty to stream from
# the user's original message instead.
LOG_CHANNEL_ID=

# --- Download server / signed links ---
# On Koyeb this is your public app URL, e.g. https://your-app-org.koyeb.app
BASE_URL=http://127.0.0.1:8080
HTTP_HOST=0.0.0.0
# Koyeb injects $PORT automatically; locally this HTTP_PORT is used.
HTTP_PORT=8080

# Secret for HMAC-signed links. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret

# Link lifetime in seconds (86400 = 24 hours).
EXPIRY_SECONDS=86400

# --- Cloudflare R2 (zero-egress storage for MERGED files) ---
# Optional. If enabled, merged files upload to R2 and users download from there
# at no egress cost. From Cloudflare dashboard -> R2.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Store single files on R2 too (free downloads for popular files; first link
# takes a couple minutes). false = instant streaming instead.
R2_SINGLE_FILES=false

# --- Limits / binaries (optional) ---
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MAX_BATCH_SIZE=50
# Max accepted file size in bytes. Default 4 GB (Telegram's hard limit).
# MAX_FILE_BYTES=4294967296

# --- Optional access control (comma separated Telegram user IDs) ---
# ALLOWED_USER_IDS=11111111,22222222
